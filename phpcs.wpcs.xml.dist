<?xml version="1.0"?>
<ruleset name="s2j-plugin-wpcs">
	<description>WordPress Coding Standards (plugin root PHP + includes/).</description>
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.FunctionComment.InvalidNoReturn"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="Squiz.Commenting.VariableComment"/>
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
		<exclude name="Squiz.PHP.CommentedOutCode"/>
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent.SpacesUsedHeredocCloser"/>
		<exclude name="WordPress.Security.NonceVerification"/>
	</rule>
	<config name="minimum_supported_wp_version" value="6.9"/>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/src/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/.dist-tmp/*</exclude-pattern>
	<exclude-pattern>*/release/*</exclude-pattern>
	<file>includes</file>
	<file>s2j-alliance-manager.php</file>
	<file>uninstall.php</file>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
</ruleset>

# Copy to .env.tests (gitignored) and adjust for your machine.
# Used by bin/phpunit-local.sh and bin/install-wp-tests.sh on first integration test run.
#
# Local (Flywheel) の例 — 公開ドキュメントでは site-id / パスをマスクすること:
#   プラグイン: ~/Local Sites/<site>/app/public/wp-content/plugins/
#   Site → Database タブで DB 名・ユーザー・パスワードを確認 (多くの場合 root / root)
#   Socket: ~/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock
#
# DB_HOST は WordPress 形式: localhost:/絶対パス/mysqld.sock （パスに空白がある場合は下記のとおり引用符で囲む）

# 必ず開発サイト DB (Local では多くの場合 "local") とは別名にすること。
WP_TESTS_DB_NAME=wordpress_test
# 接続ユーザー/パスワードは Local → Database タブと同じでよい (DB 名だけ分ける)。
WP_TESTS_DB_USER=root
WP_TESTS_DB_PASSWORD=root
# TCP のみの場合:
# WP_TESTS_DB_HOST=localhost
# Local の socket 例 (site-id はサイトごとに異なる):
# WP_TESTS_DB_HOST="localhost:/Users/<you>/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock"
WP_TESTS_DB_HOST=localhost

# WP_TESTS_WP_VERSION=latest
# WP_TESTS_SKIP_DB_CREATE=false
